#version 450

// We output 4 vertices per patch (a Quad)
layout(vertices = 4) out;

layout(location = 0) in vec2 in_tex_coords[];
layout(location = 0) out vec2 out_tex_coords[];

// Uniforms needed for distance calculation
layout(set = 0, binding = 0) uniform CameraBuffer {
    mat4 view;
    mat4 proj;
    vec3 camera_pos; 
} ubo;

// Configurable Levels
const float MIN_TESS_LEVEL = 4.0;
const float MAX_TESS_LEVEL = 64.0;
const float MIN_DISTANCE = 20.0;
const float MAX_DISTANCE = 800.0;

void main() {
    // 1. Pass through data for this specific invocation
    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
    out_tex_coords[gl_InvocationID] = in_tex_coords[gl_InvocationID];

    // 2. Calculate Levels (Only needs to happen once per patch, so usually Invocation 0 does it)
    if (gl_InvocationID == 0) {
        // Calculate center of the patch to check distance
        vec4 center = (gl_in[0].gl_Position + gl_in[1].gl_Position + gl_in[2].gl_Position + gl_in[3].gl_Position) / 4.0;
        float dist = distance(ubo.camera_pos, center.xyz);

        // Linear interpolation for detail level
        // detailed logic: (distance - min) / (max - min) ...
        float level = mix(MAX_TESS_LEVEL, MIN_TESS_LEVEL, clamp((dist - MIN_DISTANCE) / (MAX_DISTANCE - MIN_DISTANCE), 0.0, 1.0));

        // Set the Outer Levels (Edges) - Must match neighbors to avoid cracks!
        gl_TessLevelOuter[0] = level; // Left
        gl_TessLevelOuter[1] = level; // Bottom
        gl_TessLevelOuter[2] = level; // Right
        gl_TessLevelOuter[3] = level; // Top

        // Set the Inner Levels (Interior density)
        gl_TessLevelInner[0] = level; // Horizontal
        gl_TessLevelInner[1] = level; // Vertical
    }
}
